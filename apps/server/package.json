{
  "name": "@tracehawk/server",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test": "vitest run --exclude src/e2e.test.ts --exclude src/ai/postgres.integration.test.ts",
    "test:integration": "vitest run src/ai/postgres.integration.test.ts",
    "test:recorder": "vitest run src/e2e.test.ts",
    "db:deploy": "prisma migrate deploy",
    "test:ai:live": "tsx src/ai/live-check.ts",
    "benchmark": "tsx src/benchmark/cli.ts"
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.32",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "pg": "^8.13.3",
    "playwright": "^1.50.1",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "prisma": "^7.10.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}

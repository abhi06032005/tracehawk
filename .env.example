# TraceHawk Environment Configuration
PORT=4000
FRONTEND_URL=http://localhost:3001
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/tracehawk?schema=public"

# AI Integration (Optional)
# Existing DeepHat vLLM server reached through the SSH tunnel; see DEEPHAT.md.
AI_ENABLED=false
AI_PROVIDER=custom
HF_TOKEN=
AI_MODEL=DeepHat/DeepHat-V1-7B
AI_BASE_URL=http://127.0.0.1:18001/v1
AI_API_KEY=dummy
AI_JSON_MODE=schema
AI_CONTEXT_TOKENS=100000
AI_MAX_OUTPUT_TOKENS=2048
AI_REQUEST_TIMEOUT_MS=0
AI_TOKENIZER_URL=http://127.0.0.1:18001/tokenize

# Dedicated local passive scanner. Start with docker compose --profile security-test up -d
ZAP_BASE_URL=http://127.0.0.1:8080
ZAP_API_KEY=tracehawk-local-test-key
ZAP_IMPORT_DIR=../../zap-import
ZAP_CONTAINER_IMPORT_DIR=/zap/import

# Server only: never enter credentials into model prompts or browser UI.
AI_TEST_ACCOUNTS=[]
AI_ACCESS_SCENARIOS=[]

# Research Benchmark Model Providers (Optional)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MAX_RETRIES=4
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_MIN_REQUEST_INTERVAL_MS=2000
GEMINI_MAX_RETRIES=4
WHITERABBITNEO_BASE_URL=
WHITERABBITNEO_MODEL=WhiteRabbitNeo-33B


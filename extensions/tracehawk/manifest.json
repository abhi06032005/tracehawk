{
  "manifest_version": 3,
  "name": "TraceHawk Everyday Chrome Recorder",
  "version": "1.3.0",
  "minimum_chrome_version": "118",
  "description": "Record any tab or project directly in your existing Google Chrome window.",
  "permissions": [
    "activeTab",
    "debugger",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:4000/*",
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3001/*",
        "http://127.0.0.1:3001/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3001/*",
      "http://127.0.0.1:3001/*"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TraceHawk Recorder"
  }
}
